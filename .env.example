# 本地开发默认值，严禁用于生产
# 复制为 .env 后使用，真实密钥一律不进版本库

POSTGRES_DB=erp
POSTGRES_USER=erp
POSTGRES_PASSWORD=erp_dev_only
POSTGRES_PORT=5432

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

DATABASE_URL=postgresql://erp:erp_dev_only@localhost:5432/erp
JWT_SECRET=replace-me-before-any-real-deployment
API_PORT=3000

VITE_API_BASE_URL=http://localhost:3000

# demo = 离线静态数据；live = 连接本地 erp-api
DESKTOP_MODE=demo
