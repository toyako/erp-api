// 数据模型定义（ADR-0007）。P1 运行在 InMemory 适配器上，无需数据库；
// P2 接入时执行 `pnpm exec prisma generate` + `prisma migrate dev --name init`。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  @@map("tenants")
}

model Principal {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  username    String   @unique
  displayName String   @map("display_name")
  roles       String[]
  passwordHash String  @map("password_hash")
  createdAt   DateTime @default(now()) @map("created_at")
  @@map("principals")
}

model Spu {
  id           String  @id @default(uuid())
  tenantId     String  @map("tenant_id")
  name         String
  categoryCode String  @map("category_code")
  description  String?
  enabled      Boolean @default(true)
  @@map("spus")
}

model Sku {
  id           String  @id @default(uuid())
  spuId        String  @map("spu_id")
  code         String  @unique
  spec         String
  unit         String
  enabled      Boolean @default(true)
  costAmount   Int?    @map("cost_amount")
  costCurrency String? @map("cost_currency") @db.Char(3)
  @@map("skus")
}

model PriceList {
  id            String    @id @default(uuid())
  skuId         String    @map("sku_id")
  channelCode   String    @map("channel_code")
  amount        Int
  currency      String    @db.Char(3)
  effectiveFrom DateTime  @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  @@index([skuId, channelCode])
  @@map("price_lists")
}

model InventoryLot {
  id           String @id @default(uuid())
  tenantId     String @map("tenant_id")
  skuId        String @map("sku_id")
  batchCode    String @map("batch_code")
  location     String @map("location")
  availableQty Int    @map("available_qty")
  reservedQty  Int    @map("reserved_qty")
  totalQty     Int    @map("total_qty")
  @@index([skuId])
  @@map("inventory_lots")
}

model StockMovement {
  id          String   @id @default(uuid())
  lotId       String   @map("lot_id")
  type        String
  quantity    Int
  referenceId String?  @map("reference_id")
  createdAt   DateTime @default(now()) @map("created_at")
  @@map("stock_movements")
}

model SalesOrder {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  orderNo    String   @unique @map("order_no")
  customerId String?  @map("customer_id")
  status     String
  amount     Int
  currency   String   @db.Char(3)
  createdAt  DateTime @default(now()) @map("created_at")
  @@index([tenantId, status])
  @@map("sales_orders")
}

model OrderLine {
  id        String @id @default(uuid())
  orderId   String @map("order_id")
  skuId     String @map("sku_id")
  quantity  Int
  unitAmount Int   @map("unit_amount")
  currency  String @db.Char(3)
  @@index([orderId])
  @@map("order_lines")
}

model PaymentRecord {
  id        String   @id @default(uuid())
  orderId   String   @map("order_id")
  amount    Int
  currency  String   @db.Char(3)
  reference String
  createdAt DateTime @default(now()) @map("created_at")
  @@map("payment_records")
}

model AuditEvent {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  actorId    String   @map("actor_id")
  action     String
  targetType String   @map("target_type")
  targetId   String?  @map("target_id")
  payload    Json?
  createdAt  DateTime @default(now()) @map("created_at")
  @@index([tenantId, createdAt])
  @@map("audit_events")
}

/// 客户档案（客户中心）
model Customer {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  code      String   @unique
  name      String
  phone     String?
  level     String   @default("regular")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("customers")
}

/// 供应商档案（采购上下文）
model Supplier {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  code      String   @unique
  name      String
  contact   String?
  phone     String?
  rating    Int      @default(3)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("suppliers")
}

/// 采购订单：draft -> submitted -> received / cancelled
model PurchaseOrder {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  orderNo    String   @unique @map("order_no")
  supplierId String   @map("supplier_id")
  status     String
  amount     Int
  currency   String   @db.Char(3)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([tenantId, status])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id         String @id @default(uuid())
  orderId    String @map("order_id")
  skuId      String @map("sku_id")
  quantity   Int
  unitAmount Int    @map("unit_amount")
  currency   String @db.Char(3)

  @@index([orderId])
  @@map("purchase_order_lines")
}

/// 售后退货：一单只针对一个订单里一个 SKU 的数量
model Rma {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  rmaNo        String    @unique @map("rma_no")
  orderId      String    @map("order_id")
  skuId        String    @map("sku_id")
  quantity     Int
  reason       String
  status       String
  refundAmount Int       @map("refund_amount")
  currency     String    @db.Char(3)
  rejectReason String?   @map("reject_reason")
  createdAt    DateTime  @default(now()) @map("created_at")
  receivedAt   DateTime? @map("received_at")

  @@index([tenantId, status])
  @@map("rmas")
}

/// 发货单：一单只针对一个销售订单，行照抄订单行；拣货时回填每行的 batch_code
model Shipment {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  shipmentNo  String    @unique @map("shipment_no")
  orderId     String    @map("order_id")
  orderNo     String    @map("order_no")
  status      String
  carrier     String?
  trackingNo  String?   @map("tracking_no")
  createdAt   DateTime  @default(now()) @map("created_at")
  shippedAt   DateTime? @map("shipped_at")
  deliveredAt DateTime? @map("delivered_at")

  @@index([tenantId, status])
  @@map("shipments")
}

model ShipmentLine {
  id         String  @id @default(uuid())
  shipmentId String  @map("shipment_id")
  skuId      String  @map("sku_id")
  quantity   Int
  batchCode  String? @map("batch_code")
  @@index([shipmentId])
  @@map("shipment_lines")
}

/// 发票：一单可开多张，累计金额不超过订单总额；只限已付款/已完成订单
model Invoice {
  id         String    @id @default(uuid())
  tenantId   String    @map("tenant_id")
  invoiceNo  String    @unique @map("invoice_no")
  orderId    String    @map("order_id")
  orderNo    String    @map("order_no")
  customerId String?   @map("customer_id")
  amount     Int
  currency   String    @db.Char(3)
  type       String
  title      String
  status     String
  createdAt  DateTime  @default(now()) @map("created_at")
  issuedAt   DateTime? @map("issued_at")

  @@index([tenantId, status])
  @@map("invoices")
}

/// 调拨：在两个仓库/库位之间移动一个 SKU 的库存；batch_code 为完成时实际动用的源批次
model Transfer {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  transferNo    String    @unique @map("transfer_no")
  skuId         String    @map("sku_id")
  fromLocation  String    @map("from_location")
  toLocation    String    @map("to_location")
  quantity      Int
  status        String
  batchCode     String?   @map("batch_code")
  rejectReason  String?   @map("reject_reason")
  createdAt     DateTime  @default(now()) @map("created_at")
  completedAt   DateTime? @map("completed_at")

  @@index([tenantId, status])
  @@map("transfers")
}

/// 盘点：针对单个批次实盘，difference = counted_qty - system_qty，建单时快照存下
model Stocktake {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  stocktakeNo  String    @unique @map("stocktake_no")
  lotId        String    @map("lot_id")
  skuId        String    @map("sku_id")
  countedQty   Int       @map("counted_qty")
  systemQty    Int       @map("system_qty")
  difference   Int
  status       String
  createdAt    DateTime  @default(now()) @map("created_at")
  confirmedAt  DateTime? @map("confirmed_at")

  @@index([tenantId, status])
  @@map("stocktakes")
}
